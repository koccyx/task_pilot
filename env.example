# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# LLM
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt://your_folder_id/gpt-oss-120b/latest
AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
AI_PROJECT=your_folder_id
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500
SIMPLE_TASK_AGENT_RECURSION_LIMIT=30

# Kaiten
KAITEN_API_URL=https://your-domain.kaiten.ru/api/latest/
KAITEN_API_TOKEN=your_kaiten_api_token

# MCP
MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/task_pilot
POSTGRES_DB=task_pilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Bot behavior
HYBRID_MODE_ENABLED=true
TASK_EXTRACTION_DEFAULT_DAYS=1
TASK_EXTRACTION_MAX_MESSAGES=100
HEALTHCHECK_PORT=8080

# RAG
QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=internal_documents_bge_m3
RAG_WEB_PORT=8090
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_BASE_URL=http://localhost:11434
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_TIMEOUT_SECONDS=60
RAG_EMBEDDING_DIMENSION=1024
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=150
RAG_AGENT_ENABLED=true
RAG_AGENT_RESULT_LIMIT=4

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
